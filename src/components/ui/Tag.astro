---
interface Props {
  text: string;
  variant?: "pill" | "technical";
}

const { text, variant = "pill" } = Astro.props;

const shapeClass =
  variant === "pill"
    ? "rounded-[999px]"
    : "rounded-[4px]";
---

<span
  class:list={[
    "inline-block border border-nd-border-visible font-mono text-caption uppercase tracking-[0.06em] text-nd-text-secondary px-sm py-2xs",
    shapeClass,
  ]}
>
  {text}
</span>