---
/**
 * One icon family: 24px grid, 1.5px round strokes, drawn for this site.
 * Arrows render twice so the glyph can travel out and back in on hover.
 */
interface Props {
  name: "arrow-up-right" | "arrow-right" | "arrow-down" | "copy" | "check";
  class?: string;
}

const { name, class: className } = Astro.props;

const paths = {
  "arrow-up-right": "M7 17 17 7M8.5 7H17v8.5",
  "arrow-right": "M4.5 12h15M13.5 6l6 6-6 6",
  "arrow-down": "M12 4.5v15M6 13.5l6 6 6-6",
  copy: "M9 9h10.5v10.5H9zM15 9V4.5H4.5V15H9",
  check: "M5 12.5l4.5 4.5L19 7.5",
};

const travels = name.startsWith("arrow");
const copies = travels ? [0, 1] : [0];
---

<span class:list={["icon", `icon--${name}`, { "icon--travels": travels }, className]} aria-hidden="true">
  {copies.map(() => (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" focusable="false">
      <path d={paths[name]} />
    </svg>
  ))}
</span>
