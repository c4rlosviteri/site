---
import type { CTA } from "../../data/types";

interface Props {
  cta: CTA;
  class?: string;
}

const { cta } = Astro.props;
const isExternal = cta.external ?? /^https?:\/\//.test(cta.href);
---

<a
  href={cta.href}
  class:list={["cta", `cta--${cta.kind}`, Astro.props.class]}
  target={isExternal ? "_blank" : undefined}
  rel={isExternal ? "noopener noreferrer" : undefined}
>
  <span>{cta.label}</span>
  <span class="cta-arrow" aria-hidden="true">{isExternal ? "↗" : "→"}</span>
</a>
