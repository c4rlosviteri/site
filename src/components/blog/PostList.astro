---
import type { CollectionEntry } from "astro:content";
import { formatPostDate, readingMinutes } from "../../lib/blog";

interface Props {
  posts: CollectionEntry<"blog">[];
}

const { posts } = Astro.props;
---

{
  posts.length > 0 ? (
    <ul class="post-list">
      {posts.map((post) => (
        <li>
          <article class="post-summary" lang={post.data.lang}>
            <div class="post-meta">
              <time datetime={post.data.pubDate.toISOString()}>
                {formatPostDate(post)}
              </time>
              <span>{readingMinutes(post)} {post.data.lang === "es" ? "min de lectura" : "min read"}</span>
              <span>{post.data.lang === "es" ? "Español" : "English"}</span>
              {post.data.draft && <span class="draft-label">Draft · local preview</span>}
            </div>
            <div class="post-summary-copy">
              <h3>
                <a href={`/blog/${post.id}/`}>
                  {post.data.title}
                  <span aria-hidden="true">↗</span>
                </a>
              </h3>
              <p>{post.data.description}</p>
              {post.data.tags.length > 0 && (
                <ul class="post-tags" aria-label={post.data.lang === "es" ? "Temas" : "Topics"}>
                  {post.data.tags.map((tag) => <li>{tag}</li>)}
                </ul>
              )}
            </div>
          </article>
        </li>
      ))}
    </ul>
  ) : (
    <div class="blog-empty">
      <p>Notes will appear here as I publish them.</p>
      <p>Small experiments, useful discoveries, and the decisions behind the code.</p>
    </div>
  )
}
