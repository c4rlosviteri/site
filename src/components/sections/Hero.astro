---
import { site } from "../../data/site";
import type { CTA } from "../../data/types";
import CTAButton from "../ui/CTAButton.astro";
import Reveal from "../ui/Reveal.astro";
import SystemAtlas from "../ui/SystemAtlas.astro";

const workCta: CTA = {
  label: "View selected work",
  href: "#work",
  kind: "primary",
};
const emailCta: CTA = {
  label: "Email me",
  href: `mailto:${site.email}`,
  kind: "secondary",
};
---

<section id="top" class="hero" aria-labelledby="hero-title">
  <div class="hero-glow" aria-hidden="true"></div>

  <div class="hero-copy">
    <Reveal variant="fade-in">
      <p class="hero-identity">
        <span class="status-dot" aria-hidden="true"></span>
        {site.name} · {site.title}
      </p>
    </Reveal>

    <Reveal variant="fade-up" delay={80}>
      <h1 id="hero-title">
        Frontend systems.{" "}
        <span>Full-stack products.</span>
      </h1>
    </Reveal>

    <Reveal variant="fade-up" delay={160}>
      <p class="hero-intro">{site.intro}</p>
    </Reveal>

    <Reveal variant="fade-up" delay={230}>
      <div class="hero-actions">
        <CTAButton cta={workCta} />
        <CTAButton cta={emailCta} />
      </div>
    </Reveal>
  </div>

  <Reveal variant="fade-in" delay={180} class="hero-atlas">
    <SystemAtlas />
  </Reveal>

  <Reveal variant="fade-up" delay={310} class="proof-rail">
    <dl>
      <div>
        <dt>Experience</dt>
        <dd><strong>9+</strong> years</dd>
      </div>
      <div>
        <dt>Design delivery</dt>
        <dd><strong>Days → minutes</strong></dd>
      </div>
      <div>
        <dt>Team growth</dt>
        <dd>Supported <strong>3 → 8</strong> engineers</dd>
      </div>
    </dl>
  </Reveal>
</section>
