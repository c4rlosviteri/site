---
import { Image } from "astro:assets";
import portrait from "../../assets/carlos-viteri.png";
import { site } from "../../data/site";
import CTAButton from "../ui/CTAButton.astro";

const availability = site.availability?.split(" · ") ?? [];
---

<section id="top" class="hero" aria-labelledby="hero-title">
  <div class="hero-top">
    <div class="hero-identity">
      <Image src={portrait} alt="" width={72} height={72} densities={[1, 2, 3]} quality={90} format="webp" loading="eager" />
      <p>{site.name}<span class="hero-role">{site.title}</span></p>
    </div>
    <p class="hero-availability">
      <span class="hero-status"><span class="hero-status-dot" aria-hidden="true"></span>{availability.map((part, i) => <>{i > 0 && " · "}<span class="nowrap">{part}</span></>)}</span>
      <span class="hero-locale">Ecuador · {site.timezone} · English / Español</span>
    </p>
  </div>
  <h1 id="hero-title">
    <span class="hero-line"><span>Frontend platforms.</span></span>
    <span class="hero-line hero-line--accent"><span>Accessible by design.</span></span>
  </h1>
  <div class="hero-body">
    <p class="hero-intro">{site.intro}</p>
    <div class="hero-actions">
      <CTAButton cta={{label: "Email me", href: `mailto:${site.email}`, kind: "primary"}} />
      <a class="hero-work-link" href="#work">Explore the work <span aria-hidden="true">↓</span></a>
    </div>
  </div>
  <ul class="hero-evidence" aria-label="Explore engineering experience">
    <li><a href="#eatright-title"><strong>Architecture &amp; accessibility</strong><span>EatRight · Frontend architecture lead</span></a></li>
    <li><a href="#khov-title"><strong>Complex data &amp; optimization</strong><span>K. Hovnanian Homes · Hundreds of data calls optimized</span></a></li>
    <li><a href="#practice"><strong>Technical leadership</strong><span>3 engineers mentored · Hiring &amp; onboarding</span></a></li>
  </ul>
</section>
