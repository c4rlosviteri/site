---
import { site } from "../../data/site";
import type { CTA } from "../../data/types";
import CTAButton from "../ui/CTAButton.astro";
import Reveal from "../ui/Reveal.astro";

const workCta: CTA = {
  label: "View selected work",
  href: "#work",
  kind: "primary",
};
const emailCta: CTA = {
  label: "Email me",
  href: `mailto:${site.email}`,
  kind: "secondary",
};
---

<section id="top" class="hero" aria-labelledby="hero-title">
  <div class="hero-copy">
    <Reveal variant="fade-in">
      <p class="hero-identity">
        {site.name} · {site.title}
      </p>
    </Reveal>

    <Reveal variant="fade-up" delay={80}>
      <h1 id="hero-title">
        Frontend systems.{" "}
        <span>Full-stack products.</span>
      </h1>
    </Reveal>

    <Reveal variant="fade-up" delay={160}>
      <p class="hero-intro">{site.intro}</p>
    </Reveal>

    <Reveal variant="fade-up" delay={230}>
      <div class="hero-actions">
        <CTAButton cta={workCta} />
        <CTAButton cta={emailCta} />
      </div>
    </Reveal>
  </div>
</section>
