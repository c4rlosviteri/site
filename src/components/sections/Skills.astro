---
import { skills } from "../../data/portfolio";
import SectionLabel from "../ui/SectionLabel.astro";
import Reveal from "../ui/Reveal.astro";
---

<section id="skills" class="py-3xl md:py-4xl max-w-content mx-auto px-md md:px-xl" aria-labelledby="skills-heading">

  <Reveal variant="fade-in" delay={0}>
    <SectionLabel text="Skills" tag="h2" id="skills-heading" />
  </Reveal>

  <div class="mt-2xl grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-lg">
    {skills.map((category, i) => (
      <Reveal variant="fade-up" delay={i * 70}>
        <div class="group border border-nd-border hover:border-nd-border-visible bg-nd-surface hover:bg-nd-surface-raised transition-all duration-300 hover:-translate-y-[2px] hover:shadow-[0_8px_30px_rgba(0,0,0,0.4)] p-xl md:p-2xl h-full">

          <!-- Category title -->
          <h3 class="font-mono text-label uppercase tracking-[0.10em] text-nd-text-disabled mb-lg">
            {category.title}
          </h3>

          <!-- Skills list -->
          <ul class="flex flex-col gap-xs">
            {category.items.map((item) => (
              <li class="flex items-center gap-sm">
                <span class="w-[4px] h-[4px] rounded-full bg-nd-border-visible group-hover:bg-nd-accent transition-colors duration-300 shrink-0" aria-hidden="true"></span>
                <span class="text-nd-text-primary text-sm">
                  {item}
                </span>
              </li>
            ))}
          </ul>

        </div>
      </Reveal>
    ))}
  </div>

</section>
