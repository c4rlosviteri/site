---
import { experienceHighlights } from "../../data/portfolio";
import SectionLabel from "../ui/SectionLabel.astro";
import Reveal from "../ui/Reveal.astro";
---

<section id="experience" class="py-3xl md:py-4xl max-w-content mx-auto px-md md:px-xl" aria-labelledby="experience-heading">

  <Reveal variant="fade-in" delay={0}>
    <SectionLabel text="Experience" tag="h2" id="experience-heading" />
  </Reveal>

  <div class="mt-2xl flex flex-col">
    {experienceHighlights.map((item, i) => (
      <Reveal variant="fade-up" delay={i * 80}>
        <article class="group border-t border-nd-border py-2xl md:py-3xl relative">

          <!-- Header: company + role row -->
          <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-sm mb-sm">
            <div>
              <h3 class="font-display text-display-md md:text-display-lg text-nd-text-display leading-[1.05] tracking-[-0.02em]">
                {item.company}
              </h3>
              <p class="text-nd-text-secondary text-sm mt-xs max-w-[48ch]">
                {item.description}
              </p>
            </div>
            <div class="flex flex-col items-start md:items-end gap-2xs shrink-0">
              <span class="font-mono text-caption text-nd-text-secondary uppercase tracking-[0.08em]">
                {item.timeframe}
              </span>
              <span class="font-mono text-caption text-nd-text-disabled uppercase tracking-[0.08em]">
                {item.location}
              </span>
            </div>
          </div>

          <!-- Role + type -->
          <div class="flex items-center gap-sm mb-xl">
            <span class="text-nd-text-primary text-sm font-medium">
              {item.role}
            </span>
            {item.type && (
              <span class="font-mono text-caption text-nd-text-disabled uppercase tracking-[0.08em]">
                — {item.type}
              </span>
            )}
          </div>

          <!-- Bullets -->
          <ul class="flex flex-col gap-sm">
            {item.bullets.map((bullet) => (
              <li class="flex items-start gap-md">
                <span class="text-nd-accent mt-[3px] shrink-0 font-mono text-caption" aria-hidden="true">—</span>
                <span class="text-nd-text-secondary text-sm leading-relaxed">
                  {bullet}
                </span>
              </li>
            ))}
          </ul>

        </article>
      </Reveal>
    ))}

    <!-- Bottom border -->
    <div class="border-t border-nd-border"></div>
  </div>

</section>
