---
import { experienceHighlights } from "../../data/portfolio";
import SectionLabel from "../ui/SectionLabel.astro";
import Reveal from "../ui/Reveal.astro";
---

<section id="experience" class="py-3xl md:py-4xl max-w-content mx-auto px-md md:px-xl" aria-labelledby="experience-heading">

  <Reveal variant="fade-in" delay={0}>
    <SectionLabel text="Experience" tag="h2" id="experience-heading" />
  </Reveal>

  <div class="mt-2xl flex flex-col">
    {experienceHighlights.map((item, i) => (
      <Reveal variant="fade-up" delay={i * 60}>
        <div class="group relative border-t border-nd-border py-xl md:py-2xl pl-0 md:pl-xl transition-colors duration-200">
          
          <!-- Left accent bar -->
          <span
            class="hidden md:block absolute left-0 top-xl bottom-xl w-[2px] bg-nd-border group-hover:bg-nd-accent transition-colors duration-300"
            aria-hidden="true"
          ></span>
          
          <!-- Main row -->
          <div class="flex flex-col md:flex-row md:items-baseline md:justify-between gap-xs md:gap-md">
            
            <!-- Left: Company + description -->
            <div class="flex-1 min-w-0">
              <div class="flex items-center gap-sm flex-wrap">
                <h3 class="font-display text-[22px] md:text-[26px] text-nd-text-display leading-tight tracking-[-0.02em]">
                  {item.company}
                </h3>
                {item.type && (
                  <span class="font-mono text-[10px] uppercase tracking-[0.12em] text-nd-text-disabled border border-nd-border px-2xs py-[1px]">
                    {item.type}
                  </span>
                )}
              </div>
              <p class="text-nd-text-disabled text-sm mt-2xs max-w-[50ch]">
                {item.description}
              </p>
            </div>
            
            <!-- Right: Role + period -->
            <div class="md:text-right shrink-0 md:pl-xl">
              <p class="text-nd-text-secondary text-sm">
                {item.role}
              </p>
              <p class="font-mono text-caption text-nd-text-disabled uppercase tracking-[0.08em] mt-2xs">
                {item.timeframe}
              </p>
            </div>
            
          </div>
          
        </div>
      </Reveal>
    ))}
    
    <!-- Bottom border -->
    <div class="border-t border-nd-border"></div>
  </div>

</section>
