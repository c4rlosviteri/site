---
import { experienceHighlights } from "../../data/portfolio";
import SectionLabel from "../ui/SectionLabel.astro";
import Reveal from "../ui/Reveal.astro";
---

<section id="experience" class="py-3xl md:py-4xl max-w-content mx-auto px-md md:px-xl" aria-labelledby="experience-heading">

  <Reveal variant="fade-in" delay={0}>
    <SectionLabel text="Experience" tag="h2" id="experience-heading" />
  </Reveal>

  <div class="mt-2xl">
    <!-- Table header (desktop only) -->
    <div class="hidden md:grid grid-cols-[1.2fr_1fr_140px] gap-md pb-sm border-b border-nd-border mb-0">
      <span class="font-mono text-label uppercase tracking-[0.10em] text-nd-text-disabled">Company</span>
      <span class="font-mono text-label uppercase tracking-[0.10em] text-nd-text-disabled">Role</span>
      <span class="font-mono text-label uppercase tracking-[0.10em] text-nd-text-disabled text-right">Period</span>
    </div>

    {experienceHighlights.map((item, i) => (
      <Reveal variant="fade-up" delay={i * 60}>
        <div class="group border-b border-nd-border py-lg md:py-md hover:bg-nd-surface transition-colors duration-200 -mx-md px-md md:-mx-xl md:px-xl">
          
          <!-- Main row -->
          <div class="flex flex-col md:grid md:grid-cols-[1.2fr_1fr_140px] md:items-baseline gap-xs md:gap-md">
            
            <!-- Company -->
            <div>
              <span class="font-display text-[20px] md:text-[22px] text-nd-text-display leading-tight tracking-[-0.02em]">
                {item.company}
              </span>
              <span class="md:hidden font-mono text-caption text-nd-text-disabled uppercase tracking-[0.08em] ml-sm">
                {item.timeframe}
              </span>
            </div>
            
            <!-- Role -->
            <div class="flex flex-wrap items-center gap-x-sm gap-y-2xs">
              <span class="text-nd-text-secondary text-sm">
                {item.role}
              </span>
              {item.type && (
                <span class="font-mono text-[10px] uppercase tracking-[0.10em] text-nd-text-disabled border border-nd-border px-2xs py-[2px]">
                  {item.type}
                </span>
              )}
            </div>
            
            <!-- Period (desktop) -->
            <span class="hidden md:block font-mono text-caption text-nd-text-disabled uppercase tracking-[0.08em] text-right">
              {item.timeframe}
            </span>
            
          </div>
          
          <!-- Description (mobile only, or always visible) -->
          <p class="text-nd-text-disabled text-sm mt-xs max-w-[60ch]">
            {item.description}
          </p>
          
        </div>
      </Reveal>
    ))}
  </div>

</section>
