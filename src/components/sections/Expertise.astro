---
import { capabilities } from "../../data/portfolio";
import SectionLabel from "../ui/SectionLabel.astro";
import Reveal from "../ui/Reveal.astro";
---

<section id="expertise" class="py-3xl md:py-4xl max-w-content mx-auto px-md md:px-xl" aria-labelledby="expertise-heading">

  <Reveal variant="fade-in" delay={0}>
    <SectionLabel text="Expertise" tag="h2" id="expertise-heading" />
  </Reveal>

  <div class="mt-2xl grid grid-cols-1 md:grid-cols-3 gap-lg">
    {capabilities.map((cap, i) => (
      <Reveal variant="fade-up" delay={i * 90}>
        <div class="group border border-nd-border hover:border-nd-border-visible bg-nd-surface hover:bg-nd-surface-raised transition-all duration-300 p-xl md:p-2xl flex flex-col gap-lg h-full">

          <!-- Large decorative index -->
          <div class="flex items-baseline justify-between">
            <span class="font-display text-[clamp(48px,5vw,72px)] leading-none text-nd-border-visible group-hover:text-nd-accent/30 transition-colors duration-500 tracking-[-0.03em]">
              0{i + 1}
            </span>
          </div>

          <!-- Title -->
          <h3 class="font-body text-heading font-medium text-nd-text-display leading-tight tracking-[-0.01em]">
            {cap.title}
          </h3>

          <!-- Summary -->
          <p class="text-nd-text-secondary text-sm leading-relaxed flex-1">
            {cap.summary}
          </p>

          <!-- Divider -->
          <hr class="border-nd-border" />

          <!-- Item list -->
          <ul class="flex flex-col gap-sm">
            {cap.items.map((item) => (
              <li class="font-mono text-caption uppercase tracking-[0.06em] text-nd-text-secondary flex items-start gap-sm group/item">
                <span class="w-[5px] h-[5px] rounded-full bg-nd-border-visible group-hover:bg-nd-accent transition-colors duration-300 shrink-0 mt-[5px]" aria-hidden="true"></span>
                {item}
              </li>
            ))}
          </ul>

        </div>
      </Reveal>
    ))}
  </div>

</section>
