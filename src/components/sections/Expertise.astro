---
import { capabilities } from "../../data/portfolio";
---

<section id="practice" class="content-section" aria-labelledby="practice-title">
  <h2 id="practice-title">Core focus.</h2>
  <ul class="capability-list" aria-label="Areas of expertise">
    {capabilities.map((capability) => (
      <li>
        <h3>{capability.title}</h3>
        <p>{capability.summary}</p>
      </li>
    ))}
  </ul>
</section>
