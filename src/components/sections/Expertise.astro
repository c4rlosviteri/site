---
import { capabilities } from "../../data/portfolio";
import Reveal from "../ui/Reveal.astro";
---

<section
  id="practice"
  class="content-section practice-section"
  aria-labelledby="practice-title"
>
  <div class="practice-intro">
    <Reveal variant="fade-up">
      <h2 id="practice-title">What I work on.</h2>
    </Reveal>
    <Reveal variant="fade-up" delay={90}>
      <p>
        My main areas are product development, design systems, accessibility,
        and frontend platform work.
      </p>
    </Reveal>
  </div>

  <ol class="capability-stack" aria-label="Engineering layers">
    {
      capabilities.map((capability, index) => (
        <Reveal as="li" variant="fade-up" delay={index * 80}>
          <article>
            <div class="layer-index" aria-hidden="true">
              <span>Layer</span>
              <strong>{index + 1}</strong>
            </div>
            <div class="layer-copy">
              <h3>{capability.title}</h3>
              <p>{capability.summary}</p>
            </div>
            <ul>
              {capability.items.map((item) => <li>{item}</li>)}
            </ul>
          </article>
        </Reveal>
      ))
    }
  </ol>
</section>
