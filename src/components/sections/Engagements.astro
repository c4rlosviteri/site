---
import { engagements, saas } from "../../data/portfolio";
import Tag from "../ui/Tag.astro";
import Reveal from "../ui/Reveal.astro";
---

<section id="engagements" class="py-3xl md:py-4xl max-w-content mx-auto px-md md:px-xl" aria-labelledby="engagements-heading">

  <Reveal variant="fade-in" delay={0}>
    <h2 id="engagements-heading" class="font-display text-display-md md:text-display-lg text-nd-text-display leading-[1.05] tracking-[-0.02em]">
      Selected Work
    </h2>
  </Reveal>

  <div class="mt-2xl flex flex-col gap-0">
    {engagements.map((eng, i) => (
      <Reveal variant="fade-up" delay={i * 100}>
        <article
          class="group border-t border-nd-border pt-2xl pb-3xl md:pb-4xl relative"
          aria-labelledby={`eng-${eng.slug}-title`}
        >
          <!-- Two-column layout on desktop -->
          <div class="flex flex-col lg:flex-row lg:gap-4xl">
            
            <!-- Left: Title + Stack -->
            <div class="lg:w-[40%] lg:shrink-0">
              <h3
                id={`eng-${eng.slug}-title`}
                class="font-display text-display-md md:text-display-lg text-nd-text-display leading-[1.05] tracking-[-0.02em] mb-xl group-hover:text-nd-accent transition-colors duration-300"
              >
                {eng.title}
              </h3>
              
              <div class="flex flex-wrap gap-xs">
                {eng.stack.map((s) => (
                  <Tag text={s} variant="technical" />
                ))}
              </div>
            </div>

            <!-- Right: Summary + Outcomes -->
            <div class="mt-xl lg:mt-0">
              <p class="text-nd-text-primary text-[17px] leading-[1.75] mb-2xl max-w-[56ch]">
                {eng.summary}
              </p>

              <div class="flex flex-col gap-md">
                {eng.outcomes.map((outcome, j) => {
                  const match = outcome.match(/^([0-9][0-9.,]*\s*[%x+]?)\s*(.*)/);
                  return (
                    <Reveal as="div" variant="fade-up" delay={i * 100 + 80 + j * 50} class="flex items-start gap-md">
                      <span class="w-[6px] h-[6px] rounded-full bg-nd-accent mt-[8px] shrink-0" aria-hidden="true"></span>
                      {match ? (
                        <p class="text-nd-text-primary text-sm leading-relaxed">
                          <strong class="text-nd-text-display font-body font-medium text-[15px]">{match[1]}</strong>
                          {" "}{match[2]}
                        </p>
                      ) : (
                        <p class="text-nd-text-primary text-sm leading-relaxed">{outcome}</p>
                      )}
                    </Reveal>
                  );
                })}
              </div>
            </div>

          </div>
        </article>
      </Reveal>
    ))}

    <!-- Side Project -->
    <Reveal variant="fade-up" delay={engagements.length * 100 + 60}>
      <article class="border-t border-nd-border pt-2xl pb-3xl" aria-labelledby="saas-title">
        <div class="flex flex-col lg:flex-row lg:gap-4xl">
          
          <div class="lg:w-[40%] lg:shrink-0">
            <span class="font-mono text-label uppercase tracking-[0.10em] text-nd-text-disabled block mb-sm">
              Side Project
            </span>
            <h3 id="saas-title" class="font-display text-heading md:text-display-md text-nd-text-display mb-xl tracking-[-0.02em]">
              {saas.href ? <a href={saas.href} target="_blank" rel="noreferrer" class="hover:text-nd-accent transition-colors duration-300">{saas.title}</a> : saas.title}
            </h3>
            <div class="flex flex-wrap gap-xs">
              {saas.stack.map((s) => (
                <Tag text={s} variant="technical" />
              ))}
            </div>
          </div>

          <div class="mt-xl lg:mt-0">
            <p class="text-nd-text-primary text-[17px] leading-[1.75] mb-2xl max-w-[56ch]">
              {saas.summary}
            </p>
            <div class="flex flex-col gap-md">
              {saas.outcomes.map((outcome) => (
                <div class="flex items-start gap-md">
                  <span class="w-[6px] h-[6px] rounded-full bg-nd-accent mt-[8px] shrink-0" aria-hidden="true"></span>
                  <p class="text-nd-text-primary text-sm leading-relaxed">{outcome}</p>
                </div>
              ))}
            </div>
          </div>

        </div>
      </article>
    </Reveal>
  </div>

</section>
