---
import { engagements, saas } from "../../data/portfolio";
import Reveal from "../ui/Reveal.astro";
import ProjectVisual from "../ui/ProjectVisual.astro";

const visuals = {
  "react-design-system": "design-system",
  "figma-pipeline": "pipeline",
  "frontend-platform": "platform",
} as const;
---

<section id="work" class="content-section work-section" aria-labelledby="work-title">
  <Reveal variant="fade-up">
    <header class="section-intro">
      <h2 id="work-title">Selected work.</h2>
      <p>
        Three client projects and one product I built. Open each case to see
        the problem, technical decisions, and results.
      </p>
    </header>
  </Reveal>

  <div class="case-list">
    {
      engagements.map((engagement, index) => (
        <Reveal variant="fade-up" delay={index * 70}>
          <details id={engagement.slug} class="case-study">
            <summary>
              <div class="case-heading">
                <div class="case-meta">
                  <p>{engagement.sector}</p>
                  <span>{engagement.timeframe}</span>
                </div>
                <h3>{engagement.title}</h3>
                <span>{engagement.summary}</span>
                <small>{engagement.evidenceLabel}</small>
              </div>

              <ProjectVisual
                variant={visuals[engagement.slug as keyof typeof visuals]}
              />

              <div class="case-signal">
                <span>{engagement.outcomes[0]}</span>
                <span class="case-toggle">
                  <i aria-hidden="true"></i>
                  Technical notes
                </span>
              </div>
            </summary>

            <div class="case-detail">
              <div>
                <h4>Technical notes</h4>
                <dl>
                  <div>
                    <dt>Role</dt>
                    <dd>{engagement.role}</dd>
                  </div>
                  <div>
                    <dt>Project</dt>
                    <dd>{engagement.clientLabel}</dd>
                  </div>
                  <div>
                    <dt>Constraint</dt>
                    <dd>{engagement.constraint}</dd>
                  </div>
                  <div>
                    <dt>Decision</dt>
                    <dd>{engagement.decision}</dd>
                  </div>
                </dl>
              </div>

              <div>
                <h4>Results</h4>
                <ul>
                  {engagement.outcomes.map((outcome) => <li>{outcome}</li>)}
                </ul>
              </div>

              <div>
                <h4>Stack</h4>
                <ul class="stack-list">
                  {engagement.stack.map((item) => <li>{item}</li>)}
                </ul>
              </div>
            </div>
          </details>
        </Reveal>
      ))
    }
  </div>

  <Reveal variant="fade-up">
    <article class="product-case" aria-labelledby="motion-deck-title">
      <div class="product-copy">
        <p>{saas.timeframe}</p>
        <h3 id="motion-deck-title">{saas.title}</h3>
        <span>{saas.summary}</span>
        <small>
          Live product. The preview is reconstructed from the public website.
        </small>

        <ul>
          {saas.outcomes.map((outcome) => <li>{outcome}</li>)}
        </ul>

        {
          saas.href && (
            <a href={saas.href} target="_blank" rel="noopener noreferrer">
              Visit Motion Deck <span aria-hidden="true">↗</span>
            </a>
          )
        }
      </div>

      <ProjectVisual variant="product" />
    </article>
  </Reveal>
</section>
