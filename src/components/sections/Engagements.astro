---
import { engagements, saas } from "../../data/portfolio";
import SectionLabel from "../ui/SectionLabel.astro";
import Tag from "../ui/Tag.astro";
import Reveal from "../ui/Reveal.astro";
---

<section id="engagements" class="py-3xl md:py-4xl max-w-content mx-auto px-md md:px-xl" aria-labelledby="engagements-heading">

  <Reveal variant="fade-in" delay={0}>
    <SectionLabel text="Selected Work" tag="h2" id="engagements-heading" />
  </Reveal>

  <div class="mt-2xl flex flex-col gap-0">
    {engagements.map((eng, i) => (
      <Reveal variant="fade-up" delay={i * 100}>
        <article
          class="group border-t border-nd-border pt-2xl pb-2xl md:pb-3xl relative pl-0 md:pl-xl transition-colors duration-300"
          aria-labelledby={`eng-${eng.slug}-title`}
        >
          <!-- Accent left border -->
          <span
            class="hidden md:block absolute left-0 top-2xl bottom-2xl w-[1px] bg-nd-border group-hover:bg-nd-accent transition-colors duration-500"
            aria-hidden="true"
          ></span>

          <!-- Header: title + timeframe -->
          <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-sm mb-lg">
            <h3
              id={`eng-${eng.slug}-title`}
              class="font-display text-display-md md:text-display-lg text-nd-text-display leading-[1.05] tracking-[-0.02em]"
            >
              {eng.title}
            </h3>
            {eng.timeframe && (
              <span class="font-mono text-caption text-nd-text-disabled uppercase tracking-[0.08em] shrink-0">
                {eng.timeframe}
              </span>
            )}
          </div>

          <!-- Summary -->
          <p class="text-nd-text-primary text-[17px] leading-[1.75] mb-xl max-w-[64ch]">
            {eng.summary}
          </p>

          <!-- Stack -->
          <div class="flex items-baseline gap-md mb-2xl">
            <span class="font-mono text-label uppercase tracking-[0.08em] text-nd-text-disabled w-[48px]">Stack</span>
            <div class="flex flex-wrap gap-xs">
              {eng.stack.map((s) => (
                <Tag text={s} variant="technical" />
              ))}
            </div>
          </div>

          <!-- Outcomes -->
          <div>
            <span class="font-mono text-label uppercase tracking-[0.08em] text-nd-text-disabled mb-md block">
              Outcomes
            </span>
            <ul class="flex flex-col gap-sm">
              {eng.outcomes.map((outcome, j) => {
                const match = outcome.match(/^([0-9][0-9.,]*\s*[%x+]?)\s*(.*)/);
                return (
                  <Reveal as="li" variant="fade-up" delay={i * 100 + 80 + j * 50} class="flex items-start gap-md">
                    <span class="text-nd-accent mt-[2px] shrink-0 font-mono text-caption" aria-hidden="true">—</span>
                    {match ? (
                      <span class="text-nd-text-primary text-sm leading-relaxed">
                        <strong class="text-nd-text-display font-body font-medium">{match[1]}</strong>
                        {" "}{match[2]}
                      </span>
                    ) : (
                      <span class="text-nd-text-primary text-sm leading-relaxed">{outcome}</span>
                    )}
                  </Reveal>
                );
              })}
            </ul>
          </div>

        </article>
      </Reveal>
    ))}

    <!-- SaaS supporting block -->
    <Reveal variant="fade-up" delay={engagements.length * 100 + 60}>
      <article class="border-t border-nd-border pt-2xl pb-2xl" aria-labelledby="saas-title">
        <div class="flex items-start gap-xl">
          <div class="flex-1">
            <span class="font-mono text-label uppercase tracking-[0.10em] text-nd-text-disabled block mb-sm">
              Side Project
            </span>
            <h3 id="saas-title" class="font-display text-heading md:text-display-md text-nd-text-display mb-xs tracking-[-0.02em]">
              {saas.href ? <a href={saas.href} target="_blank" rel="noreferrer" class="hover:text-nd-accent transition-colors duration-300">{saas.title}</a> : saas.title}
            </h3>
            <span class="font-mono text-caption text-nd-text-secondary uppercase tracking-[0.08em]">
              {saas.role}
            </span>

            <p class="text-nd-text-secondary text-sm mt-md mb-lg max-w-[52ch] leading-relaxed">
              {saas.summary}
            </p>

            <div class="flex flex-wrap gap-xs">
              {saas.stack.map((s) => (
                <Tag text={s} variant="technical" />
              ))}
            </div>
          </div>
        </div>
      </article>
    </Reveal>
  </div>

</section>
