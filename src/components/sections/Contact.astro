---
import { site } from "../../data/site";
---

<section id="contact" class="contact-section" aria-labelledby="contact-title">
  <h2 id="contact-title">Get in touch.</h2>
  <div class="contact-actions">
    <a class="contact-link" href={`mailto:${site.email}`}>
      {site.email}<span aria-hidden="true">↗</span>
    </a>
    <button class="copy-email" type="button" data-copy-email data-email={site.email}>Copy email</button>
  </div>
  <p class="copy-status" data-copy-status aria-live="polite"></p>
  <footer>
    <p>{site.location} · {site.timezone}</p>
    <p>© {new Date().getFullYear()} {site.name}</p>
  </footer>
</section>

<script src="../../scripts/copy-email.ts"></script>
