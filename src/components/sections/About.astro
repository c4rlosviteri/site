---
import { about, skills } from "../../data/portfolio";
import Reveal from "../ui/Reveal.astro";
---

<section id="about" class="content-section about-section" aria-labelledby="about-title">
  <Reveal variant="fade-up">
    <h2 id="about-title">
      I started in frontend. Now I work across the stack.
    </h2>
  </Reveal>

  <div class="about-grid">
    <div class="about-narrative">
      {
        about.narrative.map((paragraph, index) => (
          <Reveal variant="fade-up" delay={index * 70}>
            <p>{paragraph}</p>
          </Reveal>
        ))
      }
    </div>

    <Reveal variant="fade-in" class="about-practice">
      <header>
        <p class="eyebrow">Technical stack</p>
        <h3>Tools I use in production.</h3>
      </header>
      <div class="practice-list">
        {
          skills.map((category) => (
            <section>
              <h4>{category.title}</h4>
              <p>{category.items.join(" · ")}</p>
            </section>
          ))
        }
      </div>
      {about.sasNote && <blockquote class="founder-note">{about.sasNote}</blockquote>}
    </Reveal>
  </div>
</section>
