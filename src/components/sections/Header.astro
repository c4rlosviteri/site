---
import { site } from "../../data/site";
---

<header class="site-header">
  <a class="brand-lockup" href="#top" aria-label={`${site.name}, back to top`}>
    <span class="brand-mark" aria-hidden="true">
      <img src="/favicon.svg?v=3" alt="" width="64" height="64" />
    </span>
    <span class="brand-name">{site.name}</span>
  </a>

  <nav class="site-nav" aria-label="Primary navigation">
    <a href="#work">Work</a>
    <a href="#practice">Practice</a>
    <a href="#about">About</a>
    <a href="#contact">Contact</a>
  </nav>

  <a class="header-email" href={`mailto:${site.email}`}>Email me</a>
</header>

<script src="../../scripts/navigation.ts"></script>
