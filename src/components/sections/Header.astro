---
import { site } from "../../data/site";
const isHome = Astro.url.pathname === "/";
const homeSection = (id: string) => isHome ? `#${id}` : `/#${id}`;
---

<header class="site-header">
  <a class="brand-lockup" href={isHome ? "#top" : "/"} aria-label={`${site.name}, ${isHome ? "back to top" : "home"}`}>
    <span class="brand-mark" aria-hidden="true">
      <img src="/favicon.svg?v=3" alt="" width="64" height="64" />
    </span>
    <span class="brand-name">{site.name}</span>
  </a>

  <nav class="site-nav" aria-label="Primary navigation">
    <a href={homeSection("practice")}>Skills</a>
    <a href={homeSection("contact")}>Contact</a>
  </nav>
</header>

<script src="../../scripts/navigation.ts"></script>
