---
import { Image } from "astro:assets";
import { projects } from "../../data/portfolio";
---

<section id="work" class="content-section work-section" aria-labelledby="work-title">
  <div class="work-intro">
    <h2 id="work-title">Selected work.</h2>
    <p>Some familiar names. Some of the details I helped bring to life.</p>
  </div>

  <ol class="work-list">
    {projects.map((project) => (
      <li>
        <article class:list={["work-project", { "work-project--wide": project.id === "apple" }]} aria-labelledby={`${project.id}-title`}>
          <a class="work-link" href={project.href} target="_blank" rel="noopener noreferrer" aria-labelledby={`${project.id}-title ${project.id}-link`}>
            <figure class:list={["work-image", `work-image--${project.id}`]}>
              <Image
                src={project.image}
                alt={project.imageAlt}
                widths={project.secondaryImage ? [240, 400, 600] : [480, 800, 1200]}
                sizes={project.secondaryImage ? "(max-width: 760px) 40vw, 190px" : project.id === "apple" ? "(max-width: 912px) 90vw, 816px" : "(max-width: 760px) 90vw, 420px"}
                format="webp"
                loading="lazy"
                decoding="async"
              />
              {project.secondaryImage && <Image
                src={project.secondaryImage}
                alt={project.secondaryImageAlt ?? ""}
                widths={[240, 400, 600]}
                sizes="(max-width: 760px) 40vw, 190px"
                format="webp"
                loading="lazy"
                decoding="async"
              />}
            </figure>
            <div class="work-copy">
              <div class="work-heading">
                <h3 id={`${project.id}-title`}>{project.name}</h3>
                <p class="work-headline">{project.headline}</p>
              </div>
              <div class="work-details">
                <p class="work-description">{project.description}</p>
                <ul class="work-focus" aria-label="Contributions">
                  {project.focus.map((item) => <li>{item}</li>)}
                </ul>
                <span id={`${project.id}-link`} class="work-visit">{project.linkLabel} <span aria-hidden="true">↗</span><span class="sr-only"> (opens in a new tab)</span></span>
              </div>
            </div>
          </a>
        </article>
      </li>
    ))}
  </ol>
</section>

<style>
  .work-intro { margin-bottom: 2.5rem; }
  .work-intro h2 { margin-bottom: .65rem; font-size: clamp(2rem, 4vw, 2.75rem); letter-spacing: -.035em; }
  .work-intro > p { max-width: 45ch; color: var(--muted); text-wrap: pretty; }
  .work-list { display: grid; gap: clamp(3rem, 6vw, 4.5rem); }
  .work-link { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); align-items: center; gap: clamp(1.5rem, 3.5vw, 2.5rem); }
  .work-image { display: flex; align-items: center; justify-content: center; aspect-ratio: 4 / 3; margin: 0; padding: 1.25rem; overflow: hidden; border-radius: 10px; background: var(--surface-high); }
  .work-image img { width: 100%; height: auto; border-radius: 3px; transition: transform 450ms var(--ease-out); }
  .work-link:hover .work-image img, .work-link:focus-visible .work-image img { transform: translateY(-3px); }
  .work-image--keller-williams { gap: .6rem; padding: 1rem; background: oklch(.32 .12 20); }
  .work-image--keller-williams img { width: auto; max-width: calc(50% - .3rem); height: 100%; max-height: 100%; object-fit: contain; }
  .work-image--zoom { background: oklch(.32 .11 270); }
  .work-image--khov { background: oklch(.74 .04 225); }
  .work-image--cedars-sinai { background: oklch(.33 .09 20); }
  .work-image--lpga { background: oklch(.3 .055 255); }
  .work-image--eatright { background: oklch(.4 .065 140); }
  .work-heading h3 { color: var(--muted); font-size: .9rem; font-weight: 600; line-height: 1.45; }
  .work-headline { margin-top: .55rem; color: var(--ink); font-size: clamp(1.25rem, 2.4vw, 1.55rem); font-weight: 600; letter-spacing: -.025em; line-height: 1.25; text-wrap: balance; }
  .work-description { margin-top: 1rem; color: var(--muted); font-size: .925rem; line-height: 1.7; text-wrap: pretty; }
  .work-focus { display: flex; flex-wrap: wrap; gap: .35rem .8rem; margin-top: 1rem; color: var(--text); font-size: .75rem; line-height: 1.6; }
  .work-focus li + li::before { content: "/"; padding-right: .8rem; color: var(--faint); }
  .work-visit { display: inline-flex; align-items: center; gap: .6rem; min-height: 2.75rem; margin-top: .5rem; color: var(--ink); font-size: .85rem; font-weight: 600; }
  .work-visit > span[aria-hidden] { color: var(--signal); transition: transform 250ms var(--ease-out); }
  .work-link:hover .work-visit > span[aria-hidden], .work-link:focus-visible .work-visit > span[aria-hidden] { transform: translate(2px, -2px); }
  .work-project--wide .work-link { grid-template-columns: 1fr; gap: 1.75rem; }
  .work-image--apple { aspect-ratio: 2 / 1; padding: 0; background: white; }
  .work-image--apple img { height: 100%; object-fit: contain; border-radius: 0; }
  .work-project--wide .work-copy { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr); gap: 2.5rem; }
  .work-project--wide .work-description { margin-top: 0; }

  @media (max-width: 760px) {
    .work-link, .work-project--wide .work-copy { grid-template-columns: 1fr; gap: 1.25rem; }
    .work-image { aspect-ratio: 3 / 2; padding: clamp(1rem, 4vw, 1.75rem); }
    .work-image--keller-williams { aspect-ratio: 4 / 3; }
    .work-image--apple { aspect-ratio: 1.8 / 1; padding: 0; }
    .work-project--wide .work-copy { gap: 1rem; }
    .work-headline { max-width: 30ch; font-size: 1.5rem; }
    .work-description { max-width: 65ch; }
    .work-intro { margin-bottom: 2rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .work-image img, .work-visit > span[aria-hidden] { transition: none; }
    .work-link:hover .work-image img, .work-link:focus-visible .work-image img,
    .work-link:hover .work-visit > span[aria-hidden], .work-link:focus-visible .work-visit > span[aria-hidden] { transform: none; }
  }
</style>
