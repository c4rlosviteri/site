---
import "../styles/global.css";
import Header from "../components/sections/Header.astro";
import { site } from "../data/site";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Carlos Viteri — Senior Frontend & Full-Stack Engineer",
  description = "Carlos Viteri is a senior frontend and full-stack engineer with 9+ years of experience in TypeScript, React, Next.js, Vue, Node.js, design systems, performance, and AI-assisted development.",
} = Astro.props;

const siteUrl = new URL(site.siteUrl);
const canonicalURL = new URL(Astro.url.pathname, siteUrl);
const socialImageURL = new URL(site.socialImage, siteUrl);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="author" content={site.name} />
    <meta
      name="robots"
      content="index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1"
    />
    <meta name="theme-color" content="#080a0c" />
    <meta name="color-scheme" content="dark" />
    <link rel="canonical" href={canonicalURL} />
    <title>{title}</title>

    <meta property="og:type" content="profile" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Carlos Viteri — senior frontend and full-stack engineer with 9+ years of experience"
    />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageURL} />
    <meta
      name="twitter:image:alt"
      content="Carlos Viteri — senior frontend and full-stack engineer with 9+ years of experience"
    />

    <link rel="icon" href="/favicon.svg?v=3" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32x32.png?v=3" sizes="32x32" type="image/png" />
    <link rel="icon" href="/favicon-16x16.png?v=3" sizes="16x16" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=3" />
    <link rel="manifest" href="/site.webmanifest" />
    <link
      rel="preload"
      href="/fonts/doto-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Person",
        name: site.name,
        url: site.siteUrl,
        image: socialImageURL.href,
        email: site.email,
        jobTitle: site.title,
        description,
        knowsLanguage: ["English", "Spanish"],
        knowsAbout: [
          "Full-stack software engineering",
          "AI-assisted software engineering",
          "Spec-driven development",
          "Model Context Protocol",
          "Design systems",
          "Web accessibility",
          "Frontend architecture",
          "Core Web Vitals",
          "TypeScript",
          "React",
          "Next.js",
          "Node.js",
          "Linux",
          "Git",
        ],
        hasOccupation: {
          "@type": "Occupation",
          name: "Senior Frontend & Full-Stack Engineer",
          occupationLocation: {
            "@type": "Country",
            name: "Ecuador",
          },
          skills:
            "TypeScript, JavaScript, React, Next.js, Vue, Node.js, Convex, SQL, Linux, Git, design systems, performance optimization, OpenAI Codex, Claude, Cursor, MCP, spec-driven development",
        },
      })}
    />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <Header />
    <main id="main-content">
      <slot />
    </main>
  </body>
</html>
