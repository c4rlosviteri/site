---
import "../styles/global.css";
import "../styles/blog.css";
import Header from "../components/sections/Header.astro";
import { site } from "../data/site";

interface Props {
  title?: string;
  description?: string;
  lang?: "en" | "es";
  pageType?: "profile" | "website" | "article";
  noIndex?: boolean;
}

const {
  title = "Carlos Viteri — Senior Frontend Engineer",
  description = site.intro,
  lang = "en",
  pageType = "profile",
  noIndex = false,
} = Astro.props;

const siteUrl = new URL(site.siteUrl);
const canonicalURL = new URL(Astro.url.pathname, siteUrl);
const socialImageURL = new URL(site.socialImage, siteUrl);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="author" content={site.name} />
    <meta
      name="robots"
      content={noIndex ? "noindex,nofollow" : "index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1"}
    />
    <meta name="theme-color" content="#080a0c" />
    <meta name="color-scheme" content="dark" />
    <link rel="canonical" href={canonicalURL} />
    <title>{title}</title>

    <meta property="og:type" content={pageType} />
    <meta property="og:locale" content={lang === "es" ? "es_EC" : "en_US"} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Carlos Viteri — Senior Frontend Engineer, React and TypeScript"
    />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageURL} />
    <meta
      name="twitter:image:alt"
      content="Carlos Viteri — Senior Frontend Engineer, React and TypeScript"
    />

    <link rel="icon" href="/favicon.svg?v=3" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32x32.png?v=3" sizes="32x32" type="image/png" />
    <link rel="icon" href="/favicon-16x16.png?v=3" sizes="16x16" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=3" />
    <link rel="manifest" href="/site.webmanifest" />

    {Astro.url.pathname === "/" && <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Person",
        name: site.name,
        url: site.siteUrl,
        image: socialImageURL.href,
        email: site.email,
        jobTitle: site.title,
        description: site.intro,
        knowsLanguage: ["English", "Spanish"],
        knowsAbout: [
          "React",
          "TypeScript",
          "Frontend architecture",
          "Design systems",
          "Frontend performance",
          "Product engineering",
          "Product growth",
          "Client onboarding",
          "REST API integrations",
          "Python",
          "Redux",
          "React Testing Library",
          "Automated testing",
          "Web accessibility",
          "Core Web Vitals",
          "Next.js",
          "React Native",
          "AI-assisted software engineering",
        ],
        hasOccupation: {
          "@type": "Occupation",
          name: site.title,
          occupationLocation: {
            "@type": "Country",
            name: "Ecuador",
          },
          skills:
            "TypeScript, JavaScript, React, Next.js, Vue, Redux, Node.js, Convex, Python, REST APIs, SQL, design systems, performance optimization, automated testing, React Testing Library, Jest, Cypress, CI/CD, product engineering, product growth, MVP delivery, client onboarding, AI-assisted development, reusable agent skills",
        },
      })}
    />}
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <Header />
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
  </body>
</html>
